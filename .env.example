# Salin file ini menjadi .env.local lalu isi dengan nilai dari Supabase:
# Project Settings → API → Project URL dan anon public key.
# JANGAN pernah menaruh kunci service_role di sini.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-key-di-sini

# --- Tanya Nalls (fungsi server Netlify) ---
# Variabel di bawah HANYA untuk server. Untuk situs Netlify, isi di dasbor:
#   Site configuration → Environment variables (centang "Contains secret values").
# Untuk mencoba di laptop dengan `netlify dev`, salin ke file .env (sudah di .gitignore).
# JANGAN beri awalan VITE_ : variabel VITE_* ikut terkirim ke browser dan bisa dibaca siapa saja.
# GROQ_API_KEY=isi-di-dasbor-netlify-bukan-di-sini
# TUTOR_ENABLED=false
# TUTOR_MODEL=openai/gpt-oss-120b
